<Window x:Class="Hydrocephalus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hydrocephalus.Desktop"
        mc:Ignorable="d"
        Title="Гидроцефалия — просмотр"
        WindowState="Maximized"
        Height="760" Width="1180"
        MinHeight="620" MinWidth="1000"
        Background="#101014"
        FontSize="13">

    <!-- Окно открывается развёрнутым (WindowState): снимок — главное, что на
         экране, и три вида тем полезнее, чем они крупнее. Height и Width
         остаются размером, к которому окно возвращается при восстановлении,
         а MinHeight и MinWidth названы явно: уже этого правая панель
         результата съедает место у видов, и ставить точки становится
         неудобно. -->

    <!-- Ctrl+O через стандартную команду: своё сочетание пришлось бы объяснять,
         а это врач уже знает. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenClick" />
    </Window.CommandBindings>

    <DockPanel>

        <!-- Панель управления. Клавиатурная навигация обязательна: экран должен
             работать без мыши (docs/windows/README.md). -->
        <Border DockPanel.Dock="Top" Background="#1B1B22" Padding="10,8">
            <DockPanel>

            <!-- Экспорт справа и отдельной группой: это не продолжение
                 настройки просмотра, а действие с последствиями вовне. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ExportDeidentifiedButton"
                        Content="Экспорт: о_безличенный"
                        Padding="10,4"
                        IsEnabled="False"
                        Click="OnExportDeidentifiedClick" />

                <Button x:Name="ExportClinicalButton"
                        Content="Экспорт: _клинический"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        IsEnabled="False"
                        Click="OnExportClinicalClick" />

                <Button x:Name="ExportManifestButton"
                        Content="Экспорт _манифеста"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        IsEnabled="False"
                        Click="OnExportManifestClick" />

                <!-- Администрирование не относится к разбору случая и не зависит
                     от того, открыто ли исследование: журнал ведётся всегда. -->
                <Button x:Name="AdministrationButton"
                        Content="_Администрирование"
                        Margin="18,0,0,0"
                        Padding="10,4"
                        IsEnabled="False"
                        Click="OnAdministrationClick" />
            </StackPanel>

            <!-- Состояние ручной линейки: сколько точек отмечено, что вышло,
                 можно ли записать. Здесь, а не в нижней строке состояния, где
                 оно было сначала: при разметке взгляд держится на снимке и на
                 кнопках линейки, а нижняя полоса — на другом конце окна и на
                 невысоком экране за него уходит. Сообщение, которого не видно,
                 равносильно его отсутствию. -->
            <TextBlock x:Name="RulerText"
                       DockPanel.Dock="Bottom"
                       Foreground="#C8C8D2"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="Collapsed" />

            <!-- Своя строка, а не общая с линейкой: инструменты исключают друг
                 друга, но подсказка одного не должна исчезать от того, что
                 врач тронул другой. -->
            <TextBlock x:Name="AngleText"
                       DockPanel.Dock="Bottom"
                       Foreground="#C8C8D2"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="Collapsed" />

            <!-- Перенос строк, а не одна строка: органов управления больше,
                 чем помещается рядом с экспортом, и не поместившиеся иначе
                 уходили за край окна вместе со списком серий и окном/уровнем. -->
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="OpenButton"
                        Content="_Открыть исследование…"
                        Padding="12,4"
                        Command="ApplicationCommands.Open"
                        ToolTip="Выбрать каталог с DICOM-файлами (Ctrl+O)" />

                <!-- Выбор исследования: в папке пациента их бывает несколько.
                     Открывается лучшее для анализа, остальные — здесь. -->
                <!-- Рабочий список: открывает следующее неизмеренное исследование
                     набора. Выбирать каталог в диалоге полсотни раз — и морока,
                     и источник ошибок: по двум сотням папок невозможно помнить,
                     какие уже сделаны. -->
                <Button x:Name="NextStudyButton"
                        Content="_Следующее"
                        Padding="12,4"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="OnNextStudyClick"
                        ToolTip="Открыть следующее неизмеренное исследование набора." />

                <!-- Очередей две: индекс Эванса меряется на аксиальном срезе,
                     угол — на корональном, и пригодные исследования у них
                     разные. Одна очередь на оба считала бы готовым то, у
                     которого сделана половина. -->
                <ComboBox x:Name="QueueKindSelector"
                          Width="190"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="OnQueueKindChanged"
                          ToolTip="Какое измерение считать выполненным при обходе набора.">
                    <ComboBoxItem Content="очередь: индекс Эванса" />
                    <ComboBoxItem Content="очередь: угол" />
                </ComboBox>

                <TextBlock x:Name="WorklistText"
                           Foreground="#9A9AA6"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />

                <TextBlock Text="Исследование" Foreground="#9A9AA6" Margin="18,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="StudySelector"
                          Width="260"
                          VerticalAlignment="Center"
                          IsEnabled="False"
                          DisplayMemberPath="Text"
                          SelectionChanged="OnStudyChanged"
                          ToolTip="Исследование открытой папки" />

                <!-- Выбор серии: у серии нет имени, поэтому в списке стоят
                     её свойства. Список — не украшение: приложение берёт лучшую
                     серию по своему правилу, а решает, что смотреть, врач. -->
                <TextBlock Text="Серия" Foreground="#9A9AA6" Margin="18,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="SeriesSelector"
                          Width="260"
                          VerticalAlignment="Center"
                          IsEnabled="False"
                          DisplayMemberPath="Text"
                          SelectionChanged="OnSeriesChanged"
                          ToolTip="Серия, по которой идут просмотр и анализ" />

                <CheckBox x:Name="OverlayToggle"
                          Content="_Маска"
                          Margin="18,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="#E6E6EA"
                          IsChecked="True"
                          Checked="OnOverlayChanged"
                          Unchecked="OnOverlayChanged"
                          ToolTip="Показывать наложение маски сегментации" />

                <!-- Разбор решения метода: что выбрано и что отброшено.
                     Нужен при отказе, когда маска для измерения пуста. -->
                <CheckBox x:Name="ReviewToggle"
                          Content="_Разбор метода"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="#E6E6EA"
                          IsChecked="False"
                          IsEnabled="False"
                          Checked="OnReviewChanged"
                          Unchecked="OnReviewChanged"
                          ToolTip="Вместо маски показать, что метод выбрал (оранжевый) и какой ликвор отбросил (зелёный). В измерение не идёт." />

                <!-- Ручная линейка индекса Эванса. Нужна потому, что
                     автоматический индекс выводится из маски объёмной серии, а в
                     контрольной группе ни одной пригодной объёмной серии нет:
                     сравнение групп возможно только по толстосрезовым, руками. -->
                <CheckBox x:Name="RulerToggle"
                          Content="_Линейка Эванса"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="#E6E6EA"
                          IsChecked="False"
                          IsEnabled="False"
                          Checked="OnRulerChanged"
                          Unchecked="OnRulerChanged"
                          ToolTip="Отметить четыре точки на аксиальном срезе: сначала два конца внутреннего диаметра черепа — они задают ось измерения, — затем два конца ширины передних рогов. Отрезок рогов кладётся на ось черепа, поэтому наклон нажатия и поворот головы в аппарате на результат не влияют." />

                <Button x:Name="RulerUndo"
                        Content="Отменить точку"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="OnRulerUndo" />

                <Button x:Name="RulerReset"
                        Content="Сбросить"
                        Margin="6,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="OnRulerReset" />

                <Button x:Name="RulerRecord"
                        Content="_Записать в отчёт"
                        Margin="6,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="OnRulerRecord"
                        ToolTip="Сохранить измерение новой версией отчёта. Недоступно, пока значение вне правдоподобного диапазона: точки нужно поставить заново, а не записывать заведомо неверное число." />

                <!-- Угол мозолистого тела. Второй признак плана M3 и
                     единственный, который отличает иНТГ от заместительной
                     гидроцефалии: индекс Эванса растёт и там и там. Меряется на
                     корональном срезе, а корональная серия с покрытием есть
                     почти у всего набора — в отличие от объёмной. -->
                <CheckBox x:Name="AngleToggle"
                          Content="_Угол мозолистого тела"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="#E6E6EA"
                          IsChecked="False"
                          IsEnabled="False"
                          Checked="OnAngleChanged"
                          Unchecked="OnAngleChanged"
                          ToolTip="Отметить три точки на корональном срезе: сначала вершину угла на средней линии, затем по одной точке на крыше каждого бокового желудочка. Порядок крыш не важен, поворот кадра на угол не влияет. Измерение помечается сомнительным: определение требует среза через заднюю спайку перпендикулярно линии AC-PC, а приложение их не ищет." />

                <Button x:Name="AngleUndo"
                        Content="Отменить точку"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="OnAngleUndo" />

                <Button x:Name="AngleReset"
                        Content="Сбросить"
                        Margin="6,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="OnAngleReset" />

                <Button x:Name="AngleRecord"
                        Content="Записать _угол"
                        Margin="6,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="OnAngleRecord"
                        ToolTip="Сохранить угол и наклон плоскости новой версией отчёта. Недоступно, пока значение вне правдоподобного диапазона." />

                <TextBlock Text="Центр" Foreground="#9A9AA6" Margin="24,0,6,0" VerticalAlignment="Center" />
                <Slider x:Name="CenterSlider" Width="150" VerticalAlignment="Center"
                        ValueChanged="OnWindowChanged" IsEnabled="False" />

                <TextBlock Text="Ширина" Foreground="#9A9AA6" Margin="16,0,6,0" VerticalAlignment="Center" />
                <Slider x:Name="WidthSlider" Width="150" VerticalAlignment="Center"
                        ValueChanged="OnWindowChanged" IsEnabled="False" />

                <TextBlock x:Name="WindowReadout" Foreground="#9A9AA6"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>

            </DockPanel>
        </Border>

        <!-- Строка состояния. Отдельно названо, что приложение не является
             диагностической станцией (ADR 0007).

             Фон тот же, что у окна: отдельной полосой снизу она перебивала
             снимок, а отличать её от видов не нужно — её читают, когда ищут
             глазами текст, а не когда размечают. Сам текст остаётся весь:
             и срок хранения рабочей копии, и оговорка ADR 0007 — требования,
             а не оформление. -->
        <Border DockPanel.Dock="Bottom" Background="#101014" Padding="10,6">
            <StackPanel>
            <!-- Сообщение отдельной строкой и с переносом: в одной строке со сведениями
                 об установке причина отказа обрезалась на полуслове. -->
            <TextBlock x:Name="StatusText" Foreground="#9A9AA6" TextWrapping="Wrap" Margin="0,0,0,4" Text="Исследование не открыто." />

            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Foreground="#7A7A88"
                           Text="Вспомогательный инструмент. Не является диагностической станцией." />
                <TextBlock x:Name="RoleText"
                           DockPanel.Dock="Right"
                           Foreground="#9A9AA6"
                           Margin="0,0,24,0"
                           Text="Роль: определяется…" />

                <!-- Срок хранения — сведение об установке, а не о текущей
                     операции, поэтому у него своя строка: в общей его затёрло
                     бы первое же сообщение об экспорте или об ошибке. -->
                <TextBlock x:Name="RetentionText"
                           DockPanel.Dock="Right"
                           Foreground="#7A7A88"
                           Margin="0,0,24,0" />
                <TextBlock />
            </DockPanel>
            </StackPanel>
        </Border>

        <!-- Результат справа и всегда на виду: замечания контроля качества
             и достоверность измерения — часть самого результата, а не
             дополнительные сведения, за которыми надо куда-то идти. -->
        <Border DockPanel.Dock="Right" Width="330" Background="#16161C" Padding="12,10">
            <!-- Панель доступна с клавиатуры: результат, до которого нельзя
                 долистать без мыши, для части рабочих мест не существует
                 (docs/windows/README.md). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="True"
                          IsTabStop="True">
                <StackPanel x:Name="ResultPanel">
                    <TextBlock Text="Исследование не открыто."
                               Foreground="#7A7A88"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="PlaneGrid" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

    </DockPanel>
</Window>
