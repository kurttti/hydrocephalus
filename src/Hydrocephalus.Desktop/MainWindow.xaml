<Window x:Class="Hydrocephalus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hydrocephalus.Desktop"
        mc:Ignorable="d"
        Title="Гидроцефалия — просмотр"
        Height="760" Width="1180"
        Background="#101014"
        FontSize="13">

    <!-- Ctrl+O через стандартную команду: своё сочетание пришлось бы объяснять,
         а это врач уже знает. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenClick" />
    </Window.CommandBindings>

    <DockPanel>

        <!-- Панель управления. Клавиатурная навигация обязательна: экран должен
             работать без мыши (docs/windows/README.md). -->
        <Border DockPanel.Dock="Top" Background="#1B1B22" Padding="10,8">
            <DockPanel>

            <!-- Экспорт справа и отдельной группой: это не продолжение
                 настройки просмотра, а действие с последствиями вовне. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExportDeidentifiedButton"
                        Content="Экспорт: о_безличенный"
                        Padding="10,4"
                        IsEnabled="False"
                        Click="OnExportDeidentifiedClick" />

                <Button x:Name="ExportClinicalButton"
                        Content="Экспорт: _клинический"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        IsEnabled="False"
                        Click="OnExportClinicalClick" />

                <Button x:Name="ExportManifestButton"
                        Content="Экспорт _манифеста"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        IsEnabled="False"
                        Click="OnExportManifestClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenButton"
                        Content="_Открыть исследование…"
                        Padding="12,4"
                        Command="ApplicationCommands.Open"
                        ToolTip="Выбрать каталог с DICOM-файлами (Ctrl+O)" />

                <!-- Выбор серии: у серии нет имени, поэтому в списке стоят
                     её свойства. Список — не украшение: приложение берёт лучшую
                     серию по своему правилу, а решает, что смотреть, врач. -->
                <TextBlock Text="Серия" Foreground="#9A9AA6" Margin="18,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="SeriesSelector"
                          Width="260"
                          VerticalAlignment="Center"
                          IsEnabled="False"
                          DisplayMemberPath="Text"
                          SelectionChanged="OnSeriesChanged"
                          ToolTip="Серия, по которой идут просмотр и анализ" />

                <CheckBox x:Name="OverlayToggle"
                          Content="_Маска"
                          Margin="18,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="#E6E6EA"
                          IsChecked="True"
                          Checked="OnOverlayChanged"
                          Unchecked="OnOverlayChanged"
                          ToolTip="Показывать наложение маски сегментации" />

                <TextBlock Text="Центр" Foreground="#9A9AA6" Margin="24,0,6,0" VerticalAlignment="Center" />
                <Slider x:Name="CenterSlider" Width="150" VerticalAlignment="Center"
                        ValueChanged="OnWindowChanged" IsEnabled="False" />

                <TextBlock Text="Ширина" Foreground="#9A9AA6" Margin="16,0,6,0" VerticalAlignment="Center" />
                <Slider x:Name="WidthSlider" Width="150" VerticalAlignment="Center"
                        ValueChanged="OnWindowChanged" IsEnabled="False" />

                <TextBlock x:Name="WindowReadout" Foreground="#9A9AA6"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            </DockPanel>
        </Border>

        <!-- Строка состояния. Отдельно названо, что приложение не является
             диагностической станцией (ADR 0007). -->
        <Border DockPanel.Dock="Bottom" Background="#1B1B22" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Foreground="#7A7A88"
                           Text="Вспомогательный инструмент. Не является диагностической станцией." />
                <TextBlock x:Name="RoleText"
                           DockPanel.Dock="Right"
                           Foreground="#9A9AA6"
                           Margin="0,0,24,0"
                           Text="Роль: определяется…" />
                <TextBlock x:Name="StatusText" Foreground="#9A9AA6" Text="Исследование не открыто." />
            </DockPanel>
        </Border>

        <!-- Результат справа и всегда на виду: замечания контроля качества
             и достоверность измерения — часть самого результата, а не
             дополнительные сведения, за которыми надо куда-то идти. -->
        <Border DockPanel.Dock="Right" Width="330" Background="#16161C" Padding="12,10">
            <!-- Панель доступна с клавиатуры: результат, до которого нельзя
                 долистать без мыши, для части рабочих мест не существует
                 (docs/windows/README.md). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="True"
                          IsTabStop="True">
                <StackPanel x:Name="ResultPanel">
                    <TextBlock Text="Исследование не открыто."
                               Foreground="#7A7A88"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="PlaneGrid" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

    </DockPanel>
</Window>
